    {
      "name": "3. Banco — contrato",
      "item": [
        {
          "name": "Health del banco",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "console.log(\"bank:\", pm.response.text());"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{bankBaseUrl}}/bank/v1/health"
          }
        },
        {
          "name": "Enviar pago directo (contrato)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 o 409\", () => pm.expect([201, 409]).to.include(pm.response.code));",
                  "if (pm.response.code === 201) {",
                  "  console.log(\"receiptId:\", pm.response.json().receiptId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{bankApiKey}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{bankDirectKey}}"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teamCode\": \"{{teamCode}}\",\n  \"payer\": {\n    \"customerCode\": \"CLI-0001\",\n    \"fullName\": \"Cliente de Prueba\",\n    \"taxId\": \"CF\"\n  },\n  \"amount\": {\n    \"valueInCents\": 12550,\n    \"currency\": \"GTQ\"\n  },\n  \"transactionDate\": \"2026-10-27T10:00:00-06:00\",\n  \"channel\": \"CASH\",\n  \"description\": \"Prueba directa desde Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{bankBaseUrl}}/bank/v1/payments"
          }
        },
        {
          "name": "Consultar pago por clave",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 o 404\", () => pm.expect([200, 404]).to.include(pm.response.code));",
                  "console.log(\"bank response:\", pm.response.code);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{bankApiKey}}"
              }
            ],
            "url": "{{bankBaseUrl}}/bank/v1/payments/{{bankDirectKey}}"
          }
        }
      ]
    }
