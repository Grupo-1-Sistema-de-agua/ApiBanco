{
  "info": {
    "_postman_id": "407baba5-c3d2-4c7d-bd87-616b98e608be",
    "name": "ApiBanco — Feature 3",
    "description": "Publica mensajes en RabbitMQ y prueba el contrato del banco. No dispara al productor ni al consumidor: esos se ven en logs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. RabbitMQ — publicar",
      "item": [
        {
          "name": "Éxito (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const pago = {",
                  "  idempotencyKey: pm.collectionVariables.get(\"successKey\"),",
                  "  paymentId: 999001,",
                  "  customerCode: \"CLI-0001\",",
                  "  fullName: \"Cliente de Prueba\",",
                  "  taxId: \"CF\",",
                  "  amount: \"125.50\",",
                  "  transactionDate: \"2026-10-27T10:00:00-06:00\",",
                  "  channel: \"CASH\",",
                  "  description: \"Servicio de agua 2026-10\"",
                  "};",
                  "pm.request.body.raw = JSON.stringify({",
                  "  properties: { content_type: \"application/json\", delivery_mode: 2 },",
                  "  routing_key: \"banco\",",
                  "  payload: JSON.stringify(pago),",
                  "  payload_encoding: \"string\"",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"routed\", () => pm.expect(pm.response.json().routed).to.eql(true));",
                  "console.log(\"routed:\", pm.response.json().routed);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "http://{{rabbitHost}}:{{rabbitPort}}/api/exchanges/{{vhost}}/pagos.exchange/publish",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{rabbitUser}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{rabbitPass}}",
                  "type": "string"
                }
              ]
            }
          }
        },
